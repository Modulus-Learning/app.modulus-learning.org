{
  "$schema": "https://biomejs.dev/schemas/2.4.15/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/tailwind.css",
      "!**/email-templates",
      "!**/routeTree.gen.ts",
      "!**/.output",
      "!**/.nitro",
      "!**/.tanstack"
    ]
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto",
    "bracketSpacing": true,
    "includes": ["**", "!**/dist", "!**/build", "!**/node_modules", "!**/.cache"]
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":NODE:",
              ":URL:",
              ":BLANK_LINE:",
              ["react"],
              ["@tanstack/**"],
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              {
                "type": false
              }
            ]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "warn",
        "useUniqueElementIds": "off"
      },
      "style": {
        "noNonNullAssertion": { "level": "info", "fix": "none" },
        "useSelfClosingElements": "off",
        "noParameterAssign": "error",
        "useAsConstAssertion": "error",
        "useDefaultParameterLast": "error",
        "useEnumInitializers": "error",
        "useSingleVarDeclarator": "error",
        "noUnusedTemplateLiteral": "error",
        "useNumberNamespace": "error",
        "noInferrableTypes": "error",
        "noUselessElse": "error",
        // The gradebook runs on TanStack Start; Next was removed in the
        // migration (specs/2026-10-23-gradebook-tanstack-start-migration-plan.md).
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "next": "Next.js was removed; use TanStack Start / @tanstack/react-router.",
              "react-cookie": "Read cookies on the server (@/lib/server-request)."
            },
            "patterns": [
              {
                "group": ["next/*"],
                "message": "Next.js was removed; use TanStack Start / @tanstack/react-router."
              }
            ]
          }
        }
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noConfusingVoidType": "off",
        "noArrayIndexKey": "warn"
      },
      "performance": {
        "noDelete": "off"
      },
      "a11y": {
        "useSemanticElements": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "es5",
      "semicolons": "asNeeded",
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "quoteStyle": "single",
      "attributePosition": "auto",
      "bracketSpacing": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "parser": {
      "cssModules": true
    }
  }
}
