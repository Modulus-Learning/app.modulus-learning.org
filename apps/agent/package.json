{
  "name": "@modulus-learning/agent",
  "version": "0.11.0",
  "private": false,
  "description": "Modulus client agent.",
  "keywords": [],
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/Modulus-Learning/app.modulus-learning.org",
  "bugs": {
    "url": "https://github.com/Modulus-Learning/app.modulus-learning.org/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Modulus-Learning/app.modulus-learning.org.git",
    "directory": "apps/agent"
  },
  "sideEffects": false,
  "types": "./dist/core/index.d.ts",
  "module": "./dist/core/index.js",
  "main": "./dist/core/index.js",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./browser": {
      "default": "./dist/browser/modulus-agent.js"
    },
    "./ui/vanilla": {
      "types": "./dist/ui-vanilla/index.d.ts",
      "import": "./dist/ui-vanilla/index.js",
      "default": "./dist/ui-vanilla/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules build dist .turbo",
    "build": "rm -rf dist && rolldown -c",
    "dev": "rm -rf dist && rolldown -c -w",
    "devlti": "rm -rf dist && rolldown -c -w",
    "lint": "biome check --write --diagnostic-level=error",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --mode=jsdom && vitest run --mode=node --passWithNoTests",
    "test:jsdom": "vitest run --mode=jsdom",
    "test:node": "vitest run --mode=node --passWithNoTests",
    "test:watch": "vitest --mode=jsdom"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "jsdom": "^30.1.3",
    "rolldown": "^1.2.15",
    "rolldown-plugin-dts": "^0.28.8",
    "typescript": "7.0.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": ""
}
