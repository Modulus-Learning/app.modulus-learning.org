# Public, commit-safe configuration for the gradebook. Vite inlines the VITE_*
# keys into the client bundle; the server also reads them at runtime.
#
# NEVER put a secret in this file. Secrets go in .env.local (gitignored);
# start from .env.example. Values in .env.local override this file.
VITE_SITE_NAME=MODULUS
VITE_SITE_DESCRIPTION='Modulus - an open source educational grade book and distributed learning management system.'
VITE_PUBLIC_SERVER_URL=https://app.modulus-learning.org
VITE_CSP_ENABLED=false
VITE_RECAPTCHA_ENABLED=false
VITE_RECAPTCHA_MANDATORY=false
VITE_RECAPTCHA_SITE_KEY=6LcsQL0ZAAAAALwsX4c-YK-oe76-BhPjYU3iQArK
