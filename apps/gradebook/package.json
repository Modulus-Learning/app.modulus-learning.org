    "@types/hast": "^3.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/json-schema": "^7.0.15",
    "@types/mdast": "^4.0.4",
    "@types/negotiator": "^0.6.5",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
