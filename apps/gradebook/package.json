    "motion": "^14.6.0",
    "negotiator": "^1.1.0",
    "nitro": "npm:nitro-nightly@3.0.260610-beta",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "prism-react-renderer": "^2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-hook-form": "^8.0.0-beta.5",
    "react-intersection-observer": "^11.0.1",
    "react-share": "^6.1.0",
    "react-swipeable": "^7.0.2",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
