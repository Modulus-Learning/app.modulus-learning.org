{
  "name": "@modulus-learning/gradebook",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules .output .nitro .tanstack build dist .turbo",
    "dev": "vite dev",
    "devlti": "cross-env DEV_HTTPS=true NODE_OPTIONS=--use-openssl-ca vite dev --host modulus.infonomic.local",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.local .output/server/index.mjs",
    "lint": "biome check --write --unsafe --diagnostic-level=error",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --mode=jsdom && vitest run --mode=node --passWithNoTests",
    "test:jsdom": "vitest run --mode=jsdom",
    "test:node": "vitest run --mode=node --passWithNoTests",
    "test:watch": "vitest --mode=jsdom",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "test:session": "vitest run --config vitest.session.config.ts"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@formatjs/intl-localematcher": "^0.9.0",
    "@google-cloud/recaptcha-enterprise": "^7.3.0",
    "@hookform/resolvers": "^6.0.0",
    "@infonomic/crypto": "^2.3.0",
    "@infonomic/schemas": "^2.4.0",
    "@infonomic/uikit": "^6.8.2",
    "@modulus-learning/core": "workspace:*",
    "@panva/hkdf": "^1.2.1",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "argon2": "^0.45.1",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cookie": "^2.0.1",
    "cross-env": "^10.1.0",
    "escape-html": "^1.0.3",
    "googleapis": "^188.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "intl-messageformat": "^12.1.4",
    "jose": "^6.2.13",
    "jsdom": "^30.1.3",
