{
  "name": "@modulus-learning/gradebook",
  "version": "0.9.1",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf node_modules .next build dist .turbo",
    "dev": "cross-env NODE_OPTIONS='--no-deprecation' next dev --turbopack | pino-pretty --colorize",
    "devlti": "cross-env NODE_OPTIONS='--no-deprecation --use-openssl-ca' next dev --turbopack -H modulus.infonomic.local --experimental-https --experimental-https-key ./certs/local.key --experimental-https-cert ./certs/local.crt | pino-pretty --colorize",
    "devturbo": "cross-env NODE_OPTIONS=--no-deprecation next dev --turbo",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6144\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "biome check --write --unsafe --diagnostic-level=error",
    "typecheck": "tsc --noEmit",
    "test": "vitest --mode=jsdom",
    "test:jsdom": "vitest --mode=jsdom",
    "test:node": "vitest --mode=node"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1054.0",
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@formatjs/intl-localematcher": "^0.8.8",
    "@google-cloud/recaptcha-enterprise": "^6.4.1",
    "@hookform/resolvers": "^5.4.0",
    "@infonomic/crypto": "^2.3.0",
    "@infonomic/schemas": "^2.4.0",
    "@infonomic/uikit": "^6.7.2",
    "@modulus-learning/core": "workspace:*",
    "@panva/hkdf": "^1.2.1",
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "classnames": "^2.5.1",
    "cookie": "^1.1.1",
    "cross-env": "^10.1.0",
    "escape-html": "^1.0.3",
    "googleapis": "^172.0.0",
    "gray-matter": "^4.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "intl-messageformat": "^11.2.7",
    "jose": "^6.2.3",
    "jsdom": "^29.1.1",
    "json-schema": "^0.4.0",
    "lucide-react": "^1.16.0",
    "mdast-util-to-string": "^4.0.0",
    "motion": "^12.40.0",
    "negotiator": "^1.0.0",
    "newrelic": "^14.0.0",
    "next": "16.2.6",
    "nodemailer": "^8.0.9",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prism-react-renderer": "^2.4.1",
    "react": "19.2.6",
    "react-cookie": "^8.1.2",
    "react-dom": "19.2.6",
    "react-error-boundary": "^6.1.2",
    "react-hook-form": "^7.76.1",
    "react-intersection-observer": "^10.0.3",
    "react-share": "^5.3.0",
    "react-swipeable": "^7.0.2",
    "recharts": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "serialize-error": "^13.0.1",
    "slugify": "^1.6.9",
    "tailwind-merge": "^3.6.0",
    "undici": "^8.3.0",
    "unified": "^11.0.5",
    "unique-names-generator": "^4.7.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.3",
    "zod-form-data": "^3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@next/env": "16.2.6",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/escape-html": "^1.0.4",
    "@types/hast": "^3.0.4",
    "@types/jsdom": "^28.0.3",
    "@types/json-schema": "^7.0.15",
    "@types/mdast": "^4.0.4",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "cssnano": "^8.0.1",
    "dotenv": "^17.4.2",
    "postcss": "^8.5.15",
    "tailwind-merge": "^3.2.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  }
}
