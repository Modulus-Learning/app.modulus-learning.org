{
  "name": "@modulus-learning/host-tanstack-start",
  "version": "0.11.0",
  "private": false,
  "description": "TanStack Start host for Modulus — route factories, server functions, UI, and server-entry helpers",
  "license": "AGPL-3.0-only",
  "type": "module",
  "homepage": "https://github.com/Modulus-Learning/app.modulus-learning.org",
  "bugs": {
    "url": "https://github.com/Modulus-Learning/app.modulus-learning.org/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Modulus-Learning/app.modulus-learning.org.git",
    "directory": "packages/host-tanstack-start"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles.css": "./dist/ui/styles/global.css",
    "./images/*": "./dist/images/*",
    "./ui/styles/*": "./dist/ui/styles/*",
    "./i18n/translations/*.json": "./dist/i18n/translations/*.json",
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules dist .turbo",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json && node scripts/copy-assets.mjs && node scripts/check-dist.mjs",
    "dev": "chokidar \"src/**/*\" -c \"npm-run-all build\"",
    "devlti": "chokidar \"src/**/*\" -c \"npm-run-all build\"",
    "lint": "biome check --write --diagnostic-level=error",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --mode=jsdom && vitest run --mode=node --passWithNoTests",
    "test:jsdom": "vitest run --mode=jsdom",
    "test:node": "vitest run --mode=node --passWithNoTests"
  },
