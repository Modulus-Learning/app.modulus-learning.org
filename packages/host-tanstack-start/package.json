{
  "name": "@modulus-learning/host-tanstack-start",
  "version": "0.11.0",
  "private": true,
  "description": "TanStack Start host for Modulus \u2014 route factories, server functions, UI, and server-entry helpers",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./spike/server-routes": {
      "types": "./dist/spike/server-routes.d.ts",
      "import": "./dist/spike/server-routes.js"
    },
    "./spike": {
      "types": "./dist/spike/index.d.ts",
      "import": "./dist/spike/index.js"
    },
    "./nitro/eager-boot": {
      "types": "./dist/nitro/eager-boot.d.ts",
      "import": "./dist/nitro/eager-boot.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf node_modules dist .turbo",
    "build": "rm -rf dist && tsc -p tsconfig.json && cp src/styles.css dist/styles.css",
    "lint": "biome check --write --diagnostic-level=error",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "peerDependencies": {
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.169.0",
    "nitro": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "nitro": "npm:nitro-nightly@3.0.260610-beta",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^7.0.2",
    "vite": "8.3.5"
  }
}
