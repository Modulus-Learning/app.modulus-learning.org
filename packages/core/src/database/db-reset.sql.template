/*
  Drop and recreate a local Modulus development or test database.
  The calling script refuses database names that do not end in _dev or _test.
*/

DO $$
  BEGIN
    CREATE ROLE ${db_user} WITH LOGIN;
  EXCEPTION
    WHEN duplicate_object THEN
      RAISE NOTICE 'role "${db_user}" already exists, skipping';
  END;
$$;

ALTER ROLE ${db_user} WITH PASSWORD '${db_pass}';

DROP DATABASE IF EXISTS ${db_name};

CREATE DATABASE ${db_name} WITH OWNER ${db_user};
