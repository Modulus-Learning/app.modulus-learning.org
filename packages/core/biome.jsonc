{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "root": false,
  "extends": ["../../biome.jsonc"],
  "linter": {
    "rules": {
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "zod": {
                "importNames": ["default"],
                "message": "Use 'import { z } from \"zod\"' instead of 'import z from \"zod\"'"
              }
            }
          }
        }
      }
    }
  },
  "files": {
    "includes": [
      "!**/dist",
      "!**/node_modules",
      "!src/database/migrations",
      "!src/database/schema-scripts/manifest.gen.ts",
      "!src/modules/lti/constants.ts"
    ]
  }
}
