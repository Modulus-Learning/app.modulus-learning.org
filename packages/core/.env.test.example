NODE_ENV=test

# Integration tests refuse to use a database whose name does not end in `_test`.
POSTGRES_CONNECTION_STRING=postgres://modulus:modulus@127.0.0.1:5432/modulus_test

# db_init.sh connects as this administrative role and lets psql prompt for its
# password. The local Docker Compose server creates `postgres` with password `test`.
POSTGRES_ADMIN_USER=postgres
