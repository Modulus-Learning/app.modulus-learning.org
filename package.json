{
  "name": "@modulus-learning/root",
  "version": "0.8.0",
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "clean": "turbo run clean && rm -rf node_modules",
    "build": "turbo run build",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "start": "turbo run start",
    "storybook": "turbo run storybook",
    "dev": "turbo run dev",
    "devlti": "turbo run devlti",
    "dev:seed": "turbo run dev:seed",
    "db:init": "pnpm --filter @modulus-learning/core db:init",
    "db:init:test": "pnpm --filter @modulus-learning/core db:init:test",
    "lint": "turbo run lint --continue",
    "lint:check": "biome check $(find packages/core/src packages/host-tanstack-start/src packages/lti/src packages/lms-canvas/src apps/agent/src apps/gradebook/src apps/agent-demo/react/src apps/agent-demo/vanilla/src -type f \\( -name '*.ts' -o -name '*.tsx' \\)) --diagnostic-level=error",
    "typecheck": "turbo run typecheck --continue",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration --concurrency=1",
    "ci": "pnpm lint:check && pnpm typecheck && pnpm test && pnpm test:integration && pnpm test:session && pnpm check:packages",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "version-packages": "changeset version",
    "release:tag": "turbo run build --filter=@modulus-learning/agent && changeset tag",
    "release:npm": "turbo run build --filter=@modulus-learning/agent && changeset publish",
    "prepare": "simple-git-hooks || true",
    "test:session": "turbo run build --filter=@modulus-learning/gradebook && pnpm -F @modulus-learning/gradebook test:session",
    "check:packages": "./scripts/check-packages.sh",
    "test:packed": "./scripts/packed-install.sh"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs,ts,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched --diagnostic-level=error"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.6.2",
    "@changesets/cli": "^3.0.3",
    "lint-staged": "^17.6.0",
    "publint": "^0.3.25",
    "simple-git-hooks": "^2.14.0",
    "turbo": "^2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
